#!/usr/bin/env bash
# Runs clang-tidy (including the Clang Static Analyzer) on our C++ sources:
# the core and CEF integration (.clang-tidy) and, on a Mac, the macOS UI
# (src/platform/mac/.clang-tidy). Needs a configured build directory with
# compile_commands.json.
#   scripts/lint [build-dir]     default: the debug build of scripts/build
#                                (build/debug-<arch>)
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BUILD_DIR="${1:-$ROOT/build/debug-$(uname -m)}"
CLANG_TIDY="${CLANG_TIDY:-$ROOT/.tools/bin/clang-tidy}"
command -v "$CLANG_TIDY" >/dev/null || CLANG_TIDY=clang-tidy

cd "$ROOT"
# Only what the build compiles can be checked: the CEF integration and the
# macOS UI need builds that include them.
patterns=('src/core/*.cc')
for dir in src/cef src/platform/mac; do
  if grep -q "\"file\": \".*$dir/" "$BUILD_DIR/compile_commands.json"; then
    patterns+=("$dir/*.cc" "$dir/*.mm")
  fi
done
# The standalone clang-tidy does not know where Xcode keeps the SDK headers.
extra=()
if [[ "$(uname -s)" == Darwin ]]; then
  extra+=("--extra-arg=-isysroot$(xcrun --show-sdk-path)")
fi
# Of those, only the files this build compiles: not the other systems'
# versions (process_runner_win.cc on a Mac, process_runner_posix.cc on
# Windows).
files=()
while IFS= read -r f; do
  if grep -qF "/$f\"" "$BUILD_DIR/compile_commands.json"; then
    files+=("$f")
  fi
done < <(git ls-files --cached --others --exclude-standard "${patterns[@]}")
jobs="$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4)"
# xargs exits non-zero if any clang-tidy run fails.
printf '%s\n' "${files[@]}" |
  xargs -P "$jobs" -n 4 "$CLANG_TIDY" --quiet -p "$BUILD_DIR" \
    ${extra[@]+"${extra[@]}"}
