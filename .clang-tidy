# Checks run in CI (scripts/lint). New code must not add warnings.
# Not enabled, deliberately:
# - cppcoreguidelines-owning-memory: CEF ref-counted objects are created with
#   "new" and owned by CefRefPtr, which the check cannot see.
# - modernize-use-designated-initializers, performance-enum-size: style
#   choices Chromium style does not make.
# - cert-err33-c: flags every unchecked snprintf; ours write into buffers
#   sized for the output, and truncation is harmless.
# clang-analyzer-* is the Clang Static Analyzer (path-sensitive: null
# dereferences, use after move, leaks).
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  performance-*,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-use-nodiscard,
  -modernize-use-designated-initializers,
  -performance-enum-size,
  cppcoreguidelines-init-variables,
  cppcoreguidelines-no-malloc,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-slicing,
  cppcoreguidelines-virtual-class-destructor,
  clang-analyzer-*,
  cert-*,
  -cert-err33-c
WarningsAsErrors: '*'
HeaderFilterRegex: '.*/src/(core|cef)/.*'
