# Checks run in CI (scripts/lint). New code must not add warnings.
# Not enabled, deliberately:
# - cppcoreguidelines-owning-memory: CEF ref-counted objects are created with
#   "new" and owned by CefRefPtr, which the check cannot see.
# - modernize-use-designated-initializers, performance-enum-size: style
#   choices Chromium style does not make.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  performance-*,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-use-nodiscard,
  -modernize-use-designated-initializers,
  -performance-enum-size,
  cppcoreguidelines-init-variables,
  cppcoreguidelines-no-malloc,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-slicing,
  cppcoreguidelines-virtual-class-destructor
WarningsAsErrors: '*'
HeaderFilterRegex: '.*/src/(core|cef)/.*'
