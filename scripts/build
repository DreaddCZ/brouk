#!/usr/bin/env bash
# Builds Brouk. One command for local builds (phase 1, see specs/001).
#
#   scripts/build                     Debug build for this Mac's architecture
#   scripts/build --release           Release build
#   scripts/build --arch arm64        Apple Silicon build (also from an Intel Mac)
#   scripts/build --arch x86_64       Intel build (also from an Apple Silicon Mac)
#   scripts/build --test              also run the tests
#   scripts/build --sign IDENTITY     sign with this certificate instead of
#                                     the one chosen automatically (Apple
#                                     Development, else "Brouk Local Dev")
#   scripts/build --notarizable       sign for notarization (hardened runtime,
#                                     used by scripts/package_mac)
# Both are kept for later builds in the same build folder.
#   scripts/build --updates           turn on automatic updates (feed address
#                                     and key; only scripts/release does this,
#                                     spec 019). Not kept: every build without
#                                     it has updates off.
#
# The app bundle ends up in build/<config>-<arch>/.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CONFIG=Debug
ARCH="$(uname -m)"
RUN_TESTS=0
SIGN_IDENTITY=""
HARDENED=OFF
UPDATES=OFF
while [[ $# -gt 0 ]]; do
  case "$1" in
    --release) CONFIG=Release ;;
    --debug) CONFIG=Debug ;;
    --arch) ARCH="$2"; shift ;;
    --test) RUN_TESTS=1 ;;
    --sign) SIGN_IDENTITY="$2"; shift ;;
    --notarizable) HARDENED=ON ;;
    --updates) UPDATES=ON ;;
    *) echo "Unknown option: $1" >&2; exit 2 ;;
  esac
  shift
done

"$ROOT/scripts/install_tools"
# shellcheck source=/dev/null
source "$ROOT/scripts/env.sh"

case "$(uname -s)-$ARCH" in
  Darwin-x86_64) CEF_PLATFORM=macosx64 ;;
  Darwin-arm64) CEF_PLATFORM=macosarm64 ;;
  Linux-x86_64) CEF_PLATFORM=linux64 ;;
  *) echo "Unsupported target: $(uname -s) $ARCH" >&2; exit 1 ;;
esac
"$ROOT/scripts/fetch_cef" "$CEF_PLATFORM"
if [[ "$(uname -s)" == Darwin ]]; then
  "$ROOT/scripts/fetch_sparkle"
fi

CONFIG_LOWER="$(echo "$CONFIG" | tr '[:upper:]' '[:lower:]')"
BUILD_DIR="$ROOT/build/$CONFIG_LOWER-$ARCH"
EXTRA=()
if [[ "$(uname -s)" == Darwin ]]; then
  EXTRA+=("-DCMAKE_OSX_ARCHITECTURES=$ARCH" "-DPROJECT_ARCH=$ARCH")
  if [[ -n "$SIGN_IDENTITY" ]]; then
    EXTRA+=("-DBROUK_SIGN_IDENTITY=$SIGN_IDENTITY")
  fi
  if [[ "$HARDENED" == ON ]]; then
    EXTRA+=("-DBROUK_HARDENED_RUNTIME=ON")
  fi
  EXTRA+=("-DBROUK_UPDATES=$UPDATES")
fi
# The commit shown with the version (019), e.g. "0.4.0 (a1b2c3d)".
EXTRA+=("-DBROUK_COMMIT=$(git -C "$ROOT" rev-parse --short=7 HEAD 2>/dev/null || echo unknown)")
cmake -S "$ROOT" -B "$BUILD_DIR" -G Ninja -DCMAKE_BUILD_TYPE="$CONFIG" \
  "${EXTRA[@]}"
cmake --build "$BUILD_DIR"

if [[ $RUN_TESTS -eq 1 ]]; then
  if [[ "$ARCH" == "$(uname -m)" ]]; then
    ctest --test-dir "$BUILD_DIR" --output-on-failure
  else
    echo "Skipping tests: cannot run $ARCH binaries on $(uname -m)."
  fi
fi
echo "Built in $BUILD_DIR"
