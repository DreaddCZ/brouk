#!/usr/bin/env bash
# Internal pages (web/, TypeScript; specs/001): build and test.
#
#   scripts/web build <out-dir>   compiles the pages into <out-dir> (what the
#                                 app bundle gets: .js, .html, .css; no tests)
#   scripts/web test              type-checks and runs the unit tests
#
# TypeScript comes from web/package-lock.json (pinned, integrity-checked).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=/dev/null
source "$ROOT/scripts/env.sh"
cd "$ROOT/web"

# Install (or update) the pinned TypeScript when the lockfile changed.
if [[ ! -x node_modules/.bin/tsc ||
      package-lock.json -nt node_modules/.package-lock.json ]]; then
  npm ci --ignore-scripts --no-audit --no-fund --loglevel=error
fi
TSC=node_modules/.bin/tsc

compile() {  # compile <dir>
  rm -rf "$1"
  "$TSC" -p tsconfig.json --outDir "$1"
  # The JSON viewer is a plain script, compiled on its own (see its file).
  "$TSC" -p jsonview/tsconfig.json --outDir "$1"
  "$TSC" -p adblock/tsconfig.json --outDir "$1"
  # The Requests tool shows response bodies with it too.
  cp "$1/jsonview/viewer.js" "$1/shared/json_viewer.js"
  # Pages and styles next to their scripts.
  # The password checkup's strength estimate (008), flattened for the page.
  node "$ROOT/scripts/vendor_modules.mjs" node_modules "$1/passwords" zx \
    @zxcvbn-ts/core @zxcvbn-ts/language-common @zxcvbn-ts/language-en
  find shared bookmarks downloads help history passwords profiles settings tools -name '*.html' -o -name '*.css' | while read -r f; do
    mkdir -p "$1/$(dirname "$f")"
    cp "$f" "$1/$f"
  done
  # Help (016): the Markdown content into the page; checks every help link.
  node help/build.mjs "$1"
  rm -f "$1/help/template.html"
}

case "${1:-}" in
  build)
    out="${2:?usage: scripts/web build <out-dir>}"
    compile "$out"
    find "$out" -name '*.test.js' -delete
    ;;
  test)
    out="$ROOT/build/web-test"
    compile "$out"
    # Node runs the compiled ES modules as modules.
    echo '{"type": "module"}' > "$out/package.json"
    find "$out" -name '*.test.js' -print0 | xargs -0 node --test
    ;;
  adblock)
    # The ad blocker's page scripts alone (cosmetic filtering and the
    # element picker), for embedding into the renderer.
    out="${2:?usage: scripts/web adblock <out-dir>}"
    tmp="$(mktemp -d)"
    "$TSC" -p adblock/tsconfig.json --outDir "$tmp"
    mkdir -p "$out"
    cp "$tmp/adblock/cosmetic.js" "$tmp/adblock/picker.js" "$out/"
    rm -rf "$tmp"
    ;;
  forms)
    # The forms page script (login forms, 008) as one plain script for
    # embedding into the renderer: its modules joined, without the import
    # lines and export keywords (the renderer wraps it in a function).
    out="${2:?usage: scripts/web forms <out-file>}"
    tmp="$(mktemp -d)"
    "$TSC" -p forms/tsconfig.json --outDir "$tmp"
    mkdir -p "$(dirname "$out")"
    cat "$tmp/forms/field_rules.js" "$tmp/forms/address_rules.js" "$tmp/forms/login.js" |
      grep -v '^import ' | sed -e 's/^export //' > "$out"
    rm -rf "$tmp"
    ;;
  jsonview)
    # The JSON viewer script alone, for embedding into the renderer.
    out="${2:?usage: scripts/web jsonview <out-file>}"
    tmp="$(mktemp -d)"
    "$TSC" -p jsonview/tsconfig.json --outDir "$tmp"
    mkdir -p "$(dirname "$out")"
    cp "$tmp/jsonview/viewer.js" "$out"
    rm -rf "$tmp"
    ;;
  *)
    echo "usage: scripts/web build <out-dir> | scripts/web test | scripts/web jsonview <out-file>" >&2
    exit 2
    ;;
esac
