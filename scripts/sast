#!/usr/bin/env bash
# Security checks besides the compiler and clang-tidy (scripts/lint):
#   - gitleaks:     secrets committed to the repository (whole history)
#   - Opengrep:     project rules in scripts/opengrep (with their tests)
#   - OSV-Scanner:  known vulnerabilities in the npm and Cargo lockfiles
#   - cargo-deny:   Rust advisories, licences and sources (src/adblock)
#   - zizmor:       GitHub Actions workflows
#
#   scripts/sast            everything (CI); needs the network for the
#                           vulnerability databases
#   scripts/sast --staged   only the staged changes, offline and fast: secrets
#                           and project rules (the pre-commit hook)
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=/dev/null
source "$ROOT/scripts/env.sh"
cd "$ROOT"

status=0
run() {  # run <name> <command...>: runs every check, fails at the end
  echo "== $1"
  shift
  "$@" || status=1
}

if [[ "${1:-}" == "--staged" ]]; then
  run gitleaks gitleaks git --staged --no-banner --redact --log-level=warn .
  files=()
  while IFS= read -r f; do files+=("$f"); done < <(
    git diff --cached --name-only --diff-filter=ACMR -- src web |
      grep -v '^web/node_modules/' || true)
  if [[ ${#files[@]} -gt 0 ]]; then
    run opengrep opengrep scan --config scripts/opengrep --error --quiet \
      "${files[@]}"
  fi
  exit $status
fi

run gitleaks gitleaks git --no-banner --redact --log-level=warn .
run "opengrep (rule tests)" opengrep test scripts/opengrep
run opengrep opengrep scan --config scripts/opengrep --error --quiet src web
run osv-scanner osv-scanner scan source \
  --lockfile web/package-lock.json --lockfile src/adblock/Cargo.lock
run cargo-deny cargo-deny --manifest-path src/adblock/Cargo.toml check
run zizmor zizmor --no-progress .github/workflows
exit $status
